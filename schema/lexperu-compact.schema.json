{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexperu.dev/schema/lexperu-compact.schema.json",
  "title": "LexPerú — serialización compacta de una norma",
  "type": "object",
  "required": ["tipo", "numero", "emisor", "fechaPublicacion", "titulo", "dispositivos"],
  "additionalProperties": false,
  "properties": {
    "tipo": {
      "type": "string",
      "pattern": "^[a-z0-9._]+$",
      "examples": ["ley", "decreto_legislativo", "decreto_supremo"]
    },
    "numero": { "type": "string", "minLength": 1, "maxLength": 40 },
    "emisor": { "type": "string", "pattern": "^[a-z0-9.\\-_ ]+$" },
    "fechaPublicacion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "titulo": { "type": "string", "minLength": 5, "maxLength": 600 },
    "materias": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
      "uniqueItems": true
    },
    "fuente": { "enum": ["el_peruano", "spij", "manual"] },
    "clausulaGenerica": { "type": "boolean" },
    "kbDocumentId": { "type": "string" },
    "dispositivos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["eId", "rotulo", "texto"],
        "additionalProperties": false,
        "properties": {
          "eId": { "type": "string", "pattern": "^[a-z0-9_]+$", "examples": ["art_1", "disp_comp_final_3"] },
          "rotulo": { "type": "string", "maxLength": 120 },
          "texto": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relaciones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tipo", "destinoUrn"],
        "additionalProperties": false,
        "properties": {
          "tipo": { "enum": ["DEROGA", "MODIFICA", "REMITE"] },
          "destinoUrn": { "type": "string", "pattern": "^urn:lex:pe:" },
          "origenEId": { "type": "string" },
          "destinoEId": { "type": "string" }
        }
      }
    }
  }
}
